<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    clear zera as fontes herdadas da máquina. Sem isso, o restore tenta uma
    fonte local do SDK do Visual Studio que pode não existir, e o publish
    self-contained falha com NU1301 mesmo tendo os pacotes em cache.
    Fixar nuget.org aqui deixa o build reproduzível em qualquer máquina.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
