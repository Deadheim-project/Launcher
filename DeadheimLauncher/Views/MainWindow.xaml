<Window x:Class="DeadheimLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadheimLauncher.ViewModels"
        xmlns:local="clr-namespace:DeadheimLauncher.Converters"
        Title="Deadheim" Height="600" Width="940" MinHeight="520" MinWidth="820"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <!-- Uma linha da lista de mods, usada pelas duas abas. Fica aqui e não
             em App.xaml porque o link do autor chama AbrirLink, que é código
             desta janela. -->
        <DataTemplate x:Key="ItemDeMod">
            <Border BorderBrush="#2C2521" BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                              IsEnabled="{Binding IsRequired, Converter={x:Static local:InverseBoolConverter.Instance}}"
                              VerticalAlignment="Top" Margin="0,2,10,0" />
                    <StackPanel Grid.Column="1">
                        <!-- Todos alinhados pela base: com tamanhos de fonte diferentes
                             e alinhamentos misturados, nome, versão e autor ficavam
                             visivelmente tortos entre si. -->
                        <WrapPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                       FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource MutedTextBrush}"
                                       Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
                            <!-- Crédito ao autor, clicável quando há página oficial.
                                 Sem link vira texto simples: NavigateUri é do tipo Uri
                                 e quebra o binding se receber null. -->
                            <TextBlock Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding TemLink, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="AbrirLink"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextDecorations="Underline">
                                    <Run Text="{Binding AuthorLabel, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{Binding AuthorLabel}" Margin="8,0,0,0" FontSize="11"
                                       VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"
                                       Visibility="{Binding TemAutorSemLink, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                            <TextBlock Text="obrigatório" Foreground="{StaticResource AccentBrush}"
                                       Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                       Visibility="{Binding IsRequired, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                                   FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!--
        Layout no espírito do Battle.net: a arte ocupa o palco, a barra de baixo
        concentra a ação (perfil, progresso, JOGAR), e a lista de mods sai da
        frente — vira um painel que só aparece quando pedido. Quem abre o
        launcher quer clicar em Jogar, não auditar 45 mods.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= palco ================= -->
        <Grid Grid.Row="0">
            <!-- Arte de fundo, sangrando para a direita e esmaecida para o texto
                 continuar legível por cima. -->
            <Image Source="/Assets/deadheim.png" Stretch="UniformToFill"
                   HorizontalAlignment="Right" Opacity="0.5" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#F213100E" Offset="0.0" />
                        <GradientStop Color="#D813100E" Offset="0.45" />
                        <GradientStop Color="#5513100E" Offset="1.0" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="120" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0013100E" Offset="0" />
                        <GradientStop Color="#13100E" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Cabeçalho -->
            <Grid VerticalAlignment="Top" Margin="34,26,26,0">
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="DEADHEIM" FontSize="46" FontWeight="Bold"
                               FontFamily="Segoe UI Black" Foreground="{StaticResource TextBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="2,-6,0,0">
                        <Border Width="26" Height="3" CornerRadius="2" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" />
                        <TextBlock Text="SERVIDOR DE VALHEIM" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                    <!-- Aviso de versão nova do próprio launcher. -->
                    <Border Background="#2A2119" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="10,6" Margin="0,0,10,0" VerticalAlignment="Center"
                            Visibility="{Binding MostrarAtualizacao, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding AvisoDeAtualizacao}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource TextBrush}" />
                            <Button Content="Atualizar" Padding="10,4" FontSize="11" Margin="10,0,0,0"
                                    Command="{Binding AtualizarLauncherCommand}"
                                    IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Configurações" Style="{StaticResource BotaoSecundario}" Padding="12,6"
                            VerticalAlignment="Center" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>

            <!-- ===== painel de mods, sobreposto e fechado por padrão ===== -->
            <Border Background="#F21A1614" BorderBrush="{StaticResource BorderBrush2}"
                    BorderThickness="1" CornerRadius="6" Margin="34,110,26,18"
                    Visibility="{Binding IsChecked, ElementName=BotaoMods,
                                 Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                <DockPanel Margin="16">
                    <!-- Sem título separado nem contadores: as próprias abas dizem
                         do que é cada lista, e um cabeçalho "MODS" acima de uma aba
                         "MODS" só repetiria a palavra. -->
                    <Button DockPanel.Dock="Top" HorizontalAlignment="Right" Content="Atualizar lista"
                            Padding="10,5" Margin="0,0,0,-36" Panel.ZIndex="1"
                            Style="{StaticResource BotaoSecundario}"
                            Command="{Binding RefreshManifestCommand}" />

                    <!-- Três abas: o que o servidor exige, o que é escolha do
                         jogador, e as ferramentas de admin fora do caminho. -->
                    <TabControl>
                        <TabItem Header="MODS">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <TextBlock Text="Os mods do servidor" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="O launcher instala e mantém atualizados, na mesma versão que o Deadheim usa. Não há o que configurar aqui." />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ModsDoServidor}"
                                                  ItemTemplate="{StaticResource ItemDeMod}" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="OPCIONAIS">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,120,0">
                                        <TextBlock Text="Melhorias que você escolhe" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Conveniências para o seu jogo. O servidor não exige nenhuma: com ou sem elas, você entra igual." />
                                    </StackPanel>
                                    <Button Content="Marcar todos" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="10,5" FontSize="11" Style="{StaticResource BotaoSecundario}"
                                            Command="{Binding AlternarTodosCommand}" CommandParameter="Opcional" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ModsOpcionais}"
                                                  ItemTemplate="{StaticResource ItemDeMod}" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <TabItem Header="ADMIN">
                            <DockPanel>
                                <!-- Aviso forte, não uma linha discreta. O texto descreve
                                     só o que dá para afirmar: o AzuAntiCheat do servidor
                                     usa uma lista de mods permitidos e libera quem é
                                     admin ou moderador. Como o jogo comunica a recusa
                                     não está documentado, então não afirmamos nada
                                     sobre isso. -->
                                <Border DockPanel.Dock="Top" Background="#2A1A17" CornerRadius="4"
                                        BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                        Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="SOMENTE PARA ADMINISTRADORES DO SERVIDOR"
                                                   FontWeight="Bold" FontSize="11"
                                                   Foreground="{StaticResource DangerBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Text="O Deadheim usa anticheat: o servidor mantém a lista de mods permitidos e só libera estas ferramentas para quem está como admin ou moderador. Se você não é, marcar aqui pode impedir você de entrar — e nada disso é necessário para jogar." />
                                    </StackPanel>
                                </Border>

                                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                                    <StackPanel Margin="0,0,120,0">
                                        <TextBlock Text="Ferramentas de administração" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="Comandos e edição de mundo, para quem administra o Deadheim." />
                                    </StackPanel>
                                    <Button Content="Marcar todos" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="10,5" FontSize="11" Style="{StaticResource BotaoSecundario}"
                                            Command="{Binding AlternarTodosCommand}" CommandParameter="Admin" />
                                </Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ModsDeAdmin}"
                                                  ItemTemplate="{StaticResource ItemDeMod}" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>


        <!-- ================= barra de ação ================= -->
        <Border Grid.Row="1" Background="#1A1614" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="0,1,0,0" Padding="26,16">
            <StackPanel>
                <!-- Aviso de erro dentro da janela, no lugar de popup: popup rouba
                     o foco e some com um Enter distraído, levando junto o texto
                     que dizia o que fazer. Aqui fica até o jogador fechar. -->
                <Border Background="#2A1A17" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,14"
                        Visibility="{Binding MostrarErro, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding ErroTexto}" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="{Binding ErroDetalhe}" TextWrapping="Wrap" FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding MostrarErroDetalhe, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Fechar" Style="{StaticResource BotaoSecundario}"
                                Padding="10,4" FontSize="11" VerticalAlignment="Top" Margin="12,0,0,0"
                                Command="{Binding LimparErroCommand}" />
                    </Grid>
                </Border>

                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- status e progresso -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ProgressoTexto}" HorizontalAlignment="Right" FontSize="12"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Visibility="{Binding MostrarProgresso, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                    </Grid>

                    <!-- Barra de progresso: instalar ~40 mods leva minutos e sem
                         isso a janela parece travada. -->
                    <ProgressBar Height="6" Minimum="0" Maximum="{Binding ProgressoTotal}"
                                 Value="{Binding ProgressoAtual}"
                                 Background="#0E0C0B" Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0"
                                 Visibility="{Binding MostrarProgresso, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                </StackPanel>

                <!-- ações -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="BotaoMods" Content="MODS" MinWidth="86" Height="44"
                                  Cursor="Hand" Foreground="{StaticResource TextBrush}"
                                  FontWeight="SemiBold" Margin="0,0,10,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Fundo" Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="Fundo" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Fundo" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Só libera depois da lista carregada e conferida: sem isso
                         dava para abrir o Valheim sem os mods do servidor. -->
                    <Button Content="JOGAR" FontSize="17" FontWeight="Bold" MinWidth="180" Height="44"
                            Command="{Binding PlayCommand}"
                            IsEnabled="{Binding PodeJogar}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
