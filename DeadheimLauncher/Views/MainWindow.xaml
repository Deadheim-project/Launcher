<Window x:Class="DeadheimLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadheimLauncher.ViewModels"
        xmlns:local="clr-namespace:DeadheimLauncher.Converters"
        Title="Deadheim Launcher" Height="620" Width="520"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="Deadheim Launcher" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
            <Button Content="Configurações" Margin="16,0,0,0" Padding="10,4"
                    Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Seletor de perfil -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Perfil" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}" />
                    <Button Grid.Column="1" Content="Novo" Margin="8,0,0,0" Command="{Binding CreateProfileCommand}" />
                    <Button Grid.Column="2" Content="Duplicar" Margin="8,0,0,0" Command="{Binding DuplicateProfileCommand}" />
                    <Button Grid.Column="3" Content="Excluir" Margin="8,0,0,0" Command="{Binding DeleteProfileCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Lista de mods -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Mods" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Atualizar lista" Command="{Binding RefreshManifestCommand}" />
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Mods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#3A3A42" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}"
                                                  IsEnabled="{Binding IsRequired, Converter={x:Static local:InverseBoolConverter.Instance}}"
                                                  VerticalAlignment="Top" Margin="0,2,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding VersionLabel}" Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding SourceLabel}" Foreground="{StaticResource MutedTextBrush}"
                                                           Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="obrigatório" Foreground="{StaticResource AccentBrush}"
                                                           Margin="8,0,0,0" FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{Binding IsRequired, Converter={x:Static local:BoolToVisibilityConverter.Instance}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}"
                                                       TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}"
                                                       FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="{StaticResource MutedTextBrush}"
                    Margin="0,10,0,0" TextWrapping="Wrap" />

        <!-- Play -->
        <Button Grid.Row="4" Content="JOGAR" FontSize="16" Padding="0,12" Margin="0,10,0,0"
                Command="{Binding PlayCommand}" IsEnabled="{Binding IsBusy, Converter={x:Static local:InverseBoolConverter.Instance}}" />
    </Grid>
</Window>
