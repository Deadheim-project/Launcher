<Window x:Class="DeadheimLauncher.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deadheim Launcher" Height="160" Width="360"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="ResponseBox" Padding="6" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="OK" Padding="14,6" Click="Ok_Click" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
