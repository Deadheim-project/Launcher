<Window x:Class="DeadheimLauncher.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deadheim" Width="420"
        SizeToContent="Height" MinHeight="190"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <!--
        SizeToContent="Height" em vez de altura fixa: antes eram 160px cravados
        com ResizeMode=NoResize, e o conteúdo (rótulo + campo + botões + margens)
        passava disso contando a barra de título. Os botões OK/Cancelar ficavam
        cortados fora da janela, e a mensagem, se quebrasse em duas linhas,
        empurrava tudo. Agora a janela acompanha o conteúdo.
    -->
    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="14"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="HintText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,12"
                       Visibility="Collapsed" />

            <TextBox x:Name="ResponseBox" FontSize="14" />

            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontSize="11"
                       Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}"
                        Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <Button Content="Confirmar" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
