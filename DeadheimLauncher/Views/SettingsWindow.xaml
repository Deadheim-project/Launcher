<Window x:Class="DeadheimLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Height="260" Width="480"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Pasta do Valheim (deixe em branco para detectar via Steam)" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ValheimPathBox" Grid.Column="0" Padding="6" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Procurar..." Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <TextBlock Text="URL do manifest.json do servidor" Margin="0,16,0,4" />
        <TextBox x:Name="ManifestUrlBox" Padding="6" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Salvar" Padding="14,6" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
