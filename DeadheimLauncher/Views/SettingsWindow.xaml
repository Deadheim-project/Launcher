<Window x:Class="DeadheimLauncher.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações" Height="540" Width="480"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Text="Pasta do Valheim (deixe em branco para detectar via Steam)" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ValheimPathBox" Grid.Column="0" Padding="6" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Procurar..." Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>

        <TextBlock Text="URL do manifest.json do servidor" Margin="0,16,0,4" />
        <TextBox x:Name="ManifestUrlBox" Padding="6" />

        <TextBlock Text="Servidor Deadheim" Margin="0,16,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ServerHostBox" Grid.Column="0" Padding="6" />
            <TextBox x:Name="ServerPortBox" Grid.Column="1" Padding="6" Margin="8,0,0,0" />
        </Grid>

        <TextBlock Text="Senha do servidor" Margin="0,12,0,4" />
        <PasswordBox x:Name="ServerPasswordBox" Padding="6" />

        <Separator Margin="0,20,0,0" />

        <TextBlock Text="Problema com os mods?" Margin="0,14,0,4" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Opacity="0.75" FontSize="11"
                   Text="Apaga os mods que o launcher instalou. Suas escolhas de opcionais e a pasta do Valheim não são tocadas — o próximo Jogar baixa tudo de novo." />
        <Button x:Name="UninstallButton" Content="Desinstalar mods" HorizontalAlignment="Left"
                Padding="14,6" Margin="0,8,0,0" Click="Uninstall_Click" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Padding="14,6" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Salvar" Padding="14,6" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
