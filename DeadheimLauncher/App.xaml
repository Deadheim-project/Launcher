<Application x:Class="DeadheimLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Paleta do Deadheim: carvão quente com brasa e osso, em vez do
                 cinza-azulado genérico de antes. -->
            <SolidColorBrush x:Key="BgBrush" Color="#13100E" />
            <SolidColorBrush x:Key="PanelBrush" Color="#1D1917" />
            <SolidColorBrush x:Key="PanelHoverBrush" Color="#272220" />
            <SolidColorBrush x:Key="BorderBrush2" Color="#3A322D" />
            <SolidColorBrush x:Key="AccentBrush" Color="#C4602A" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#DD7539" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#A24C1F" />
            <SolidColorBrush x:Key="TextBrush" Color="#EDE6DC" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#998C80" />
            <SolidColorBrush x:Key="DangerBrush" Color="#D4574B" />
            <SolidColorBrush x:Key="OkBrush" Color="#7FA86B" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <!-- Botão com template próprio: o chrome padrão do Windows ignora
                 Background no hover e voltava a ficar azul-claro. -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#17120F" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Fundo" Property="Background" Value="#3A322D" />
                                    <Setter Property="Foreground" Value="#7A7069" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botão secundário: mesma forma, sem o peso da brasa. -->
            <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    CornerRadius="3" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource PanelHoverBrush}" />
                                    <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#6B625C" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="#0E0C0B" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Style.Triggers>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <!--
                O ComboBox precisa de template próprio, e não é preciosismo: o
                template padrão desenha o item selecionado num TextBlock interno,
                que herdava o estilo global de TextBlock (texto claro) sobre o
                fundo claro do chrome do Windows. Resultado: o nome do perfil
                ficava branco no branco, invisível.
            -->
            <!--
                Mesma armadilha do ComboBox: o MenuItem padrão desenha o texto
                num TextBlock interno, que herda o estilo global (claro), sobre o
                fundo claro do chrome do Windows. Resultado: menu ilegível.
                Template próprio com Foreground explícito resolve de vez.
            -->
            <!--
                Template próprio também no ContextMenu, não só no MenuItem: o
                template padrão desenha uma faixa clara à esquerda (a coluna de
                ícones/marca de seleção) que ignora o Background e cobria parte
                do texto dos itens.
            -->
            <Style TargetType="ContextMenu">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    CornerRadius="4" Padding="4" SnapsToDevicePixels="True">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="12,7" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}" CornerRadius="2">
                                <ContentPresenter ContentSource="Header"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="#17120F" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#6B625C" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Mesma armadilha do ComboBox e do MenuItem: o TabItem padrão
                 desenha a aba com o chrome claro do Windows e o rótulo herda o
                 estilo global de TextBlock, ficando ilegível. -->
            <Style TargetType="TabItem">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="Fundo" Background="Transparent" Padding="14,8" Margin="0,0,4,0"
                                    BorderBrush="Transparent" BorderThickness="0,0,0,2">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontWeight="SemiBold" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Fundo" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush2}"
                                        BorderThickness="0,0,0,1" Margin="0,0,0,10">
                                    <TabPanel IsItemsHost="True" HorizontalAlignment="Left" />
                                </Border>
                                <ContentPresenter ContentSource="SelectedContent" />
                            </DockPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Separator">
                <Setter Property="Background" Value="{StaticResource BorderBrush2}" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="6,4" />
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="#17120F" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="#0E0C0B" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="Alternador" Focusable="False" ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Caixa" Background="{StaticResource PanelBrush}"
                                                    BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                                    CornerRadius="3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="22" />
                                                    </Grid.ColumnDefinitions>
                                                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource MutedTextBrush}" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Caixa" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Foreground explícito: é o que impede o texto de
                                     voltar a sumir se o estilo global mudar. -->
                                <ContentPresenter Margin="10,0,26,0" VerticalAlignment="Center"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  TextElement.Foreground="{StaticResource TextBrush}" />

                                <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                       IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                       PopupAnimation="Slide">
                                    <Border Background="{StaticResource PanelBrush}"
                                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="260">
                                        <ScrollViewer>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
